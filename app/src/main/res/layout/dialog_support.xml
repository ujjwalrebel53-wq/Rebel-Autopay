<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:gravity="center"
        android:text="@string/dialog_title"
        android:textColor="@color/matrix_green_glow"
        android:textSize="17sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/matrix_green_dim" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/dialog_message"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnDialogTelegram"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/btn_gradient_primary"
        android:fontFamily="monospace"
        android:text="@string/join_telegram"
        android:textAllCaps="false"
        android:textColor="@color/bg_dark"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnDialogLater"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/btn_ghost"
        android:fontFamily="monospace"
        android:text="@string/later"
        android:textAllCaps="false"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />
</LinearLayout>
